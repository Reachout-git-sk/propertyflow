# Database OWNER connection. Used only by Prisma migrations and the seed script,
# never by the running app (the owner skips row-level security).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/propertyflow?schema=public"

# The app's own connection, as the restricted propertyflow_app role, so row-level security applies.
# The role is created by the row_level_security migration; give it this password with:
#   npm run db:app-role
# The password below is only for the local Docker database (reachable from this computer only).
# Use a long random password from a secret store anywhere else.
APP_DATABASE_URL="postgresql://propertyflow_app:local-dev-only-password@localhost:5432/propertyflow?schema=public"

# JWT secret: signs login tokens. Required; the app refuses to start if it is missing,
# shorter than 32 characters, or a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# How long a login token is valid: a number plus s, m, h or d (default 1h)
JWT_EXPIRES_IN="1h"

# Server
PORT=5000
NODE_ENV="development"

# Only when the app runs behind a load balancer or reverse proxy (for example AWS ALB):
# the number of proxies in front of it, so rate limits see each visitor's real IP.
# Leave unset locally; setting it without a proxy lets clients fake their IP.
# TRUST_PROXY=1

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend URL
FRONTEND_URL="http://localhost:5173"
