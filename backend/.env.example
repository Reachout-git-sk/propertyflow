# Database - Replace with your credentials
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/propertyflow?schema=public"

# JWT Secret - Generate random key for production
JWT_SECRET="CHANGE-THIS-TO-RANDOM-SECRET-KEY"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend URL
FRONTEND_URL="http://localhost:5173"