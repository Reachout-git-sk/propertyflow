
# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
# package-lock.json is committed on purpose: `npm ci` (Docker and CI) needs it

# Environment variables - NEVER COMMIT!
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Build outputs
dist/
build/
backend/dist/
frontend/dist/

# Logs
*.log
logs/
backend/logs/

# Uploads & temp files
backend/uploads/
*.tmp

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Database
*.db
*.sqlite

# Prisma: migration.sql files are committed on purpose.
# `prisma migrate deploy` (Dockerfile and CI) can only apply migrations that are in git.